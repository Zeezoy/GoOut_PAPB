{
  "name": "goout-firestore-rules-tests",
  "private": true,
  "description": "Security rules tests for firestore.rules, run against the Firebase Emulator Suite.",
  "scripts": {
    "pretest": "node -e \"require('fs').copyFileSync('../firestore.rules','firestore.rules')\"",
    "test": "firebase emulators:exec --only firestore --project goout-rules-test \"node --test tests/rules.test.js\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase": "^11.10.0",
    "firebase-tools": "^13.35.1"
  }
}
