# Normalize line endings: LF in the repository, native on checkout where it matters.
* text=auto

# Source and config files are always LF in the repo.
*.kt text
*.kts text
*.java text
*.xml text
*.md text
*.yml text
*.yaml text
*.json text
*.properties text
*.rules text
*.gradle text

# Shell scripts must stay LF; Windows batch files must stay CRLF.
gradlew text eol=lf
*.sh text eol=lf
*.bat text eol=crlf

# Binary files.
*.png binary
*.jpg binary
*.webp binary
*.jar binary
*.keystore binary
